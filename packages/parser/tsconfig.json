{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declarationMap": true,
    "paths": {
      "@rfc-inspector/common": [
        "../common/src/index.ts"
      ],
      "@rfc-inspector/common/*": [
        "../common/src/*"
      ],
      "@rfc-inspector/lexer": [
        "../lexer/src/index.ts"
      ],
      "@rfc-inspector/lexer/*": [
        "../lexer/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../common"
    },
    {
      "path": "../lexer"
    },
  ]
}