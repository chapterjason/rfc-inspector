{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/types",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react",
    "paths": {
      "@rfc-inspector/common": [
        "../common/src/index.ts"
      ],
      "@rfc-inspector/common/*": [
        "../common/src/*"
      ],
      "@rfc-inspector/tokenizer": [
        "../tokenizer/src/index.ts"
      ],
      "@rfc-inspector/tokenizer/*": [
        "../tokenizer/src/*"
      ],
      "@rfc-inspector/lexer": [
        "../lexer/src/index.ts"
      ],
      "@rfc-inspector/lexer/*": [
        "../lexer/src/*"
      ],
      "@rfc-inspector/parser": [
        "../parser/src/index.ts"
      ],
      "@rfc-inspector/parser/*": [
        "../parser/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../common"
    },
    {
      "path": "../lexer"
    },
    {
      "path": "../tokenizer"
    },
    {
      "path": "../parser"
    }
  ]
}
